  m_SharedData: {fileID: 11400000, guid: f711ccf11634e1648914c75d1fe39c71, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2631692288
    m_Localized: "\uC720\uB2DB\uC744 \uC0DD\uC131\uD574 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2673635328
    m_Localized: "\uC720\uB2DB\uC744 \uB4DC\uB798\uADF8\uD574 \uC6D0\uD558\uB294
      \uC704\uCE58\uC5D0 \uBC30\uCE58\uD574 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2673635329
    m_Localized: "\uC900\uBE44\uAC00 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4. \uC6E8\uC774\uBE0C
      1\uC744 \uC2DC\uC791\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2673635330
    m_Localized: "\uC720\uB2DB\uC774 \uC801\uC744 \uB9C9\uC544\uB0B4\uB294 \uBAA8\uC2B5\uC744
      \uC9C0\uCF1C\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829632
    m_Localized: "\uC720\uB2DB\uC744 \uD558\uB098 \uB354 \uC0DD\uC131\uD574 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829633
    m_Localized: "\uAC19\uC740 1\uC131 \uC720\uB2DB \uB450 \uAE30\uAC00 \uC790\uB3D9\uC73C\uB85C
      \uD569\uC131\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829634
    m_Localized: "2\uC131 \uC720\uB2DB\uACFC \uD568\uAED8 \uC6E8\uC774\uBE0C 2\uB97C
      \uC2DC\uC791\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829635
    m_Localized: "\uC131\uAE09\uC774 \uC624\uB974\uBA74 \uC720\uB2DB\uC774 \uB354\uC6B1
      \uAC15\uD574\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829636
    m_Localized: "3\uC131 \uD569\uC131\uC744 \uC900\uBE44\uD558\uAE30 \uC704\uD574
      \uC720\uB2DB\uC744 \uD558\uB098 \uB354 \uC0DD\uC131\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829637
    m_Localized: "\uC5D8\uB9AC\uD2B8 \uC6E8\uC774\uBE0C\uB97C \uC2DC\uC791\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829638
    m_Localized: "\uC5D8\uB9AC\uD2B8 \uC801\uC744 \uCC98\uCE58\uD558\uBA74 \uD2B9\uBCC4\uD55C
      \uC720\uBB3C\uC744 \uD68D\uB4DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829639
    m_Localized: "\uC6D0\uD558\uB294 \uC720\uBB3C \uD558\uB098\uB97C \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829640
    m_Localized: "\uC720\uB2DB\uC744 \uD558\uB098 \uB354 \uC0DD\uC131\uD574 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829641
    m_Localized: "{unitB}\uC744(\uB97C) \uB04C\uC5B4\uC11C \uB9AC\uB864 \uC601\uC5ED\uC5D0
      \uB193\uC73C\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829642
    m_Localized: "\uB9AC\uB864\uB85C \uC5BB\uC740 {unitA}\uC774(\uAC00) \uC790\uB3D9
      \uD569\uC131\uB418\uC5B4 3\uC131\uC774 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829643
    m_Localized: "\uC778\uAD6C\uC218\uB97C \uB298\uB9AC\uBA74 \uB354 \uB9CE\uC740
      \uC720\uB2DB\uC744 \uBC30\uCE58\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829644
    m_Localized: "\uC774\uC81C \uB0A8\uC740 \uC6E8\uC774\uBE0C\uB97C \uC790\uC720\uB86D\uAC8C
      \uC9C4\uD589\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829645
    m_Localized: "\uCCAB \uC804\uD22C\uC5D0\uC11C \uC2B9\uB9AC\uD588\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 2677829646
    m_Localized: "\uB3CC\uC544\uAC00\uAE30 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uB85C\uBE44\uB85C
      \uC774\uB3D9\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829647
    m_Localized: "\uC720\uB2DB \uD0ED\uC5D0\uC11C \uC804\uD22C\uC5D0 \uCC38\uC5EC\uD560
      \uBD80\uB300\uC640 \uBCF4\uC720 \uC720\uB2DB\uC744 \uAD00\uB9AC\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4. \uC720\uB2DB \uD0ED\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829648
    m_Localized: "\uBCF4\uC720 \uC720\uB2DB\uC744 \uC120\uD0DD\uD558\uBA74 \uD6C8\uB828,
      \uC9C4\uAE09, \uD55C\uACC4\uB3CC\uD30C\uC640 \uC7A5\uBE44\uB97C \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC720\uB2DB \uD558\uB098\uB97C \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829649
    m_Localized: "\uD6C8\uB828 \uC7AC\uB8CC\uB97C \uC120\uD0DD\uD558\uACE0 \uD6C8\uB828\uD558\uC5EC
      \uC720\uB2DB\uC744 \uD55C \uBC88 \uC131\uC7A5\uC2DC\uCF1C \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829650
    m_Localized: "\uC9C4\uAE09\uC740 \uC804\uC6A9 \uC7AC\uB8CC\uB85C \uB2A5\uB825\uCE58\uC640
      \uC2A4\uD0AC\uC744 \uAC15\uD654\uD569\uB2C8\uB2E4. \uC9C4\uAE09 \uD0ED\uC744
      \uB20C\uB7EC \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829651
    m_Localized: "\uD55C\uACC4\uB3CC\uD30C\uB294 \uC911\uBCF5 \uC720\uB2DB\uC744
      \uC0AC\uC6A9\uD574 \uC131\uC7A5 \uD55C\uACC4\uB97C \uD655\uC7A5\uD569\uB2C8\uB2E4.
      \uD55C\uACC4\uB3CC\uD30C \uD0ED\uC744 \uB20C\uB7EC \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829652
    m_Localized: "\uC7A5\uBE44\uB294 \uC720\uB2DB\uC758 \uB2A5\uB825\uCE58\uB97C
      \uCD94\uAC00\uB85C \uAC15\uD654\uD569\uB2C8\uB2E4. \uC7A5\uBE44 \uD0ED\uC744
      \uB20C\uB7EC \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829653
    m_Localized: "\uD68D\uB4DD\uD55C \uC7A5\uBE44\uB97C \uC774\uACF3\uC5D0\uC11C
      \uCC29\uC6A9\uD558\uACE0 \uAC15\uD654\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uD655\uC778\uC744 \uB9C8\uCCE4\uB2E4\uBA74 \uC720\uB2DB \uC0C1\uC138 \uD654\uBA74\uC744
      \uB2EB\uC73C\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829654
    m_Localized: "\uC5F0\uAD6C\uC18C\uAC00 \uD574\uAE08\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC5F0\uAD6C\uC18C\uC5D0\uC11C \uC0C8\uB85C\uC6B4 \uC5F0\uAD6C\uB97C \uAC1C\uBC1C\uD574
      \uC804\uD22C \uB2A5\uB825\uC744 \uAC15\uD654\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829655
    m_Localized: "\uC5F0\uAD6C \uC7AC\uD654\uB97C \uC0AC\uC6A9\uD574 \uC5F0\uAD6C
      \uD6C4\uBCF4\uB97C \uD655\uC778\uD558\uACE0 \uD558\uB098\uB97C \uC120\uD0DD\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uACC4\uC815 \uB808\uBCA8\uC774 \uC624\uB97C\uC218\uB85D
      \uB354 \uB9CE\uC740 \uC5F0\uAD6C \uAE30\uD68C\uAC00 \uC5F4\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829656
    m_Localized: "\uB808\uBCA8\uC5C5"
    m_Metadata:
      m_Items: []
  - m_Id: 2677829657
    m_Localized: "\uC5F0\uB8CC \uCD5C\uB300\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 2677829658
    m_Localized: "\uC0C8\uB85C\uC6B4 \uC5F0\uAD6C\uB97C \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829659
    m_Localized: "\uBC14\uAE65 \uC601\uC5ED\uC744 \uD0ED\uD558\uC5EC \uB2EB\uC73C\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829660
    m_Localized: "\uBD88\uB7EC\uC624\uB294 \uC911"
    m_Metadata:
      m_Items: []
  - m_Id: 2677829661
    m_Localized: "\uAC19\uC740 \uC720\uB2DB\uACFC \uAC19\uC740 \uC131\uAE09\uC774
      \uB9CC\uB098\uBA74 \uB354 \uB192\uC740 \uC131\uAE09\uC73C\uB85C \uC790\uB3D9
      \uD569\uC131\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829662
    m_Localized: "\uC900\uBE44 \uB2E8\uACC4\uC5D0\uC11C\uB294 \uC720\uB2DB\uC744
      \uB4DC\uB798\uADF8\uD574 \uC790\uC720\uB86D\uAC8C \uBC30\uCE58\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829663
    m_Localized: "\uD544\uC694\uD558\uC9C0 \uC54A\uC740 \uC720\uB2DB\uC740 \uD310\uB9E4\uD574
      \uC804\uD22C \uC7AC\uD654\uB97C \uD68C\uC218\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829664
    m_Localized: "\uC778\uAD6C\uC218\uB97C \uB298\uB9AC\uBA74 \uC804\uC7A5\uC5D0
      \uB354 \uB9CE\uC740 \uC720\uB2DB\uC744 \uBC30\uCE58\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829665
    m_Localized: "\uC5D8\uB9AC\uD2B8 \uC801\uC744 \uCC98\uCE58\uD558\uBA74 \uC804\uD22C\uC5D0
      \uB3C4\uC6C0\uC774 \uB418\uB294 \uC720\uBB3C\uC744 \uC120\uD0DD\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2677829666
    m_Localized: "\uB9AC\uB864\uC740 \uC720\uB2DB\uC758 \uC131\uAE09\uC744 \uC720\uC9C0\uD558\uBA74\uC11C
      \uB2E4\uB978 \uC720\uB2DB\uC73C\uB85C \uBCC0\uACBD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
